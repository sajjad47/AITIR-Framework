{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sajjad47/AITIR-Framework/schemas/aitir-evidence-v2.schema.json",
  "title": "AITIR Evidence Object",
  "description": "Provenance-linked analytical evidence; never an authorization command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "schema_version", "created_at", "expires_at", "producer", "subject_id", "event_ids", "analysis_window", "provenance", "scores", "uncertainty", "risk_drivers", "quality", "applicability", "integrity"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{3,128}$"},
    "schema_version": {"const": "2.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "resource_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "analysis_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_schema_version", "pipeline_version"],
      "properties": {
        "feature_schema_version": {"type": "string"},
        "pipeline_version": {"type": "string"},
        "model_version": {"type": ["string", "null"]},
        "calibrator_version": {"type": ["string", "null"]},
        "rule_set_version": {"type": ["string", "null"]},
        "graph_version": {"type": ["string", "null"]},
        "threat_intelligence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score_type", "value"],
        "properties": {
          "name": {"type": "string"},
          "score_type": {"enum": ["heuristic-risk", "anomaly", "calibrated-probability", "graph-confidence", "impact", "policy-risk"]},
          "value": {"type": "number"},
          "unit": {"type": ["string", "null"]},
          "calibration_status": {"enum": ["not-applicable", "not-calibrated", "validated", "degraded", "unknown"]}
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "value", "meaning"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "risk_drivers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counter_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "attack_mappings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_health", "data_quality_flags"],
      "properties": {
        "source_health": {"enum": ["healthy", "degraded", "failed", "unknown"]},
        "data_quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["in-domain", "out-of-domain", "unknown"]},
        "reason": {"type": "string"}
      }
    },
    "recommended_action": {"type": ["string", "null"]},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
